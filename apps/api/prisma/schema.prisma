generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleGlobal {
  ADMIN
  MEMBRE
}

enum RoleBureau {
  MANAGER
  COLLABORATEUR
}

enum StatutProjet {
  EN_COURS
  TERMINE
  ARCHIVE
}

enum StatutTache {
  A_FAIRE
  ACCEPTEE
  EN_COURS
  DECLARE
  VALIDE
  A_REVOIR
}

// Santé : distincte du statut. Une tâche "En cours" peut dériver (À_RISQUE)
// ou être bloquée sans que son statut change.
enum SanteTache {
  NORMAL
  A_SURVEILLER
  A_RISQUE
  BLOQUEE
}

enum PrioriteTache {
  BASSE
  NORMALE
  HAUTE
  URGENTE
}

enum TypeBlocage {
  TACHE
  PERSONNE
  DECISION
  CLIENT
  RESSOURCE
  EXTERNE
}

enum StatutValidationDeclaration {
  EN_ATTENTE
  VALIDEE
  LITIGE
}

model Organisation {
  id             String   @id @default(uuid())
  nom            String
  logoUrl        String?  @map("logo_url")
  proprietaireId String   @map("proprietaire_id")
  planAbonnement String?  @map("plan_abonnement")
  dateCreation   DateTime @default(now()) @map("date_creation")

  bureaux     Bureau[]
  users       User[]
  invitations Invitation[]

  @@map("organisations")
}

enum CouleurBureau {
  BLUE
  PURPLE
  GREEN
  AMBER
  PINK
  SLATE
  RED
  ORANGE
  TEAL
  CYAN
  INDIGO
  ROSE
}

enum NiveauAlerte {
  AUCUNE
  ORANGE
  ROUGE
}

model Bureau {
  id             String @id @default(uuid())
  organisationId String @map("organisation_id")
  nom            String
  fuseauHoraire  String @default("UTC") @map("fuseau_horaire")

  // Rituel de déclaration quotidienne (paramétrable par le manager, cf. 2.6)
  heureDeclaration           String  @default("18:30") @map("heure_declaration")
  delaiRelanceMinutes        Int     @default(60) @map("delai_relance_minutes")
  classementFiabiliteVisible Boolean @default(true) @map("classement_fiabilite_visible")

  couleur  CouleurBureau @default(BLUE)
  photoUrl String?       @map("photo_url")
  ordre    Int           @default(0)

  // "Set to Orange/Red" — alerte temporaire affichée sur la card et en bannière
  // dans l'office ; expire d'elle-même une fois alerteJusqua dépassée (pas de job
  // planifié nécessaire, on compare juste à l'heure courante à la lecture).
  niveauAlerte  NiveauAlerte @default(AUCUNE) @map("niveau_alerte")
  alerteJusqua  DateTime?    @map("alerte_jusqua")

  createdAt DateTime @default(now()) @map("created_at")

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  membres      UserBureau[]
  invitations  BureauInvitation[]
  projets      Projet[]
  conversation Conversation?

  @@index([organisationId])
  @@map("bureaux")
}

model Conversation {
  id                       String    @id @default(uuid())
  bureauId                 String?   @unique @map("bureau_id")
  // Un Organizer (projet) peut avoir plusieurs Conversations nommées ("Subjects") ;
  // le chat de bureau, lui, en a toujours exactement une (bureauId reste unique).
  projetId                 String?   @map("projet_id")
  // Nom du Subject ; sans effet pour la conversation de bureau (toujours unique).
  nom                      String    @default("General")
  // Dernière génération de tâches par l'IA pour ce Subject (cf. organizer.processor).
  derniereGenerationTaches DateTime? @map("derniere_generation_taches")
  // Dernier échec définitif (toutes tentatives épuisées) — permet d'afficher un état
  // d'erreur au lieu de rester bloqué sur "Not processed yet" en silence pour toujours.
  dernierEchecTraitement   DateTime? @map("dernier_echec_traitement")
  createdAt                DateTime  @default(now()) @map("created_at")

  // Message direct 1:1 (ni bureau ni organizer). userAId < userBId par convention
  // pour qu'une paire d'utilisateurs n'ait jamais deux conversations distinctes.
  userAId String? @map("user_a_id")
  userBId String? @map("user_b_id")
  // Dernière lecture de chaque côté — sert à calculer le badge "non lu" du Chat.
  lastReadAtA DateTime? @map("last_read_at_a")
  lastReadAtB DateTime? @map("last_read_at_b")

  bureau   Bureau?            @relation(fields: [bureauId], references: [id], onDelete: Cascade)
  projet   Projet?            @relation(fields: [projetId], references: [id], onDelete: Cascade)
  userA    User?              @relation("ConversationsAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User?              @relation("ConversationsAsB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]
  taches   Tache[]
  reads    ConversationRead[]

  @@unique([userAId, userBId])
  @@index([projetId])
  @@map("conversations")
}

/**
 * Marqueur "vu" par utilisateur pour un chat de groupe (bureau ou Subject
 * d'organizer) — les DM ont leur propre mécanisme (lastReadAtA/B) car ils
 * n'ont que deux participants.
 */
model ConversationRead {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  lastReadAt     DateTime @default(now()) @map("last_read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_reads")
}

model Message {
  id                String   @id @default(uuid())
  conversationId    String   @map("conversation_id")
  auteurId          String   @map("auteur_id")
  contenu           String?
  edited            Boolean  @default(false)
  replyToId         String?  @map("reply_to_id")
  mentionedUserIds  String[] @default([]) @map("mentioned_user_ids")
  createdAt         DateTime @default(now()) @map("created_at")

  // Pièce jointe optionnelle (cf. phase D — pas de vidéos, images limitées en poids)
  fichierUrl          String? @map("fichier_url")
  fichierNom          String? @map("fichier_nom")
  fichierType         String? @map("fichier_type")
  fichierTailleOctets Int?    @map("fichier_taille_octets")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  auteur       User         @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReplies")

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Identité de connexion globale : un compte peut avoir une adhésion (User) par organisation.
model Account {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  // Pays déduit de l'IP à l'inscription (best-effort, jamais bloquant).
  pays         String?
  // Modération plateforme (super admin) : banned bloque toute connexion,
  // restricted limite aux requêtes en lecture (GET) uniquement.
  banned       Boolean  @default(false)
  restricted   Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  users               User[]
  passwordResetTokens PasswordResetToken[]

  @@map("accounts")
}

model User {
  id             String     @id @default(uuid())
  accountId      String     @map("account_id")
  organisationId String     @map("organisation_id")
  nom            String
  email          String
  roleGlobal     RoleGlobal @default(MEMBRE) @map("role_global")
  emailVerifie   Boolean    @default(false) @map("email_verifie")
  poste          String?
  bio            String?
  photoUrl       String?    @map("photo_url")
  // Petite fiche perso, visible par toute l'organisation (page Members) — chacun
  // remplit la sienne depuis son propre profil.
  hierarchie       String?
  dateAnniversaire DateTime? @map("date_anniversaire") @db.Date
  aime             String?
  naimePas         String?   @map("naime_pas")

  createdAt DateTime @default(now()) @map("created_at")

  account                  Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organisation             Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  bureaux                  UserBureau[]
  bureauInvitations        BureauInvitation[]
  tachesAssignees          Tache[]                  @relation("TachesAssignees")
  tachesAttribuees         Tache[]                  @relation("TachesAttribuees")
  tachesValidees           Tache[]                  @relation("TachesValidees")
  declarationsJournalieres DeclarationJournaliere[]
  scoresFiabilite          ScoreFiabilite[]
  refreshTokens            RefreshToken[]
  notifications            Notification[]
  emailVerificationTokens  EmailVerificationToken[]
  conversationsAsA         Conversation[]           @relation("ConversationsAsA")
  conversationsAsB         Conversation[]           @relation("ConversationsAsB")
  conversationReads        ConversationRead[]
  messages                 Message[]
  projetsPersonnels        Projet[]
  blocagesResponsable      TacheBlocage[]
  tachesSessions           TacheSession[]
  pushSubscriptions        PushSubscription[]

  @@unique([accountId, organisationId])
  @@index([organisationId])
  @@index([accountId])
  @@map("users")
}

model UserBureau {
  userId         String     @map("user_id")
  bureauId       String     @map("bureau_id")
  roleDansBureau RoleBureau @default(COLLABORATEUR) @map("role_dans_bureau")
  roleInterne    String?    @map("role_interne") // ex. "Développeur", "Designer" — utilisé par l'IA

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bureau Bureau @relation(fields: [bureauId], references: [id], onDelete: Cascade)

  @@id([userId, bureauId])
  @@map("users_bureaux")
}

// Une adhésion à un bureau exige le consentement explicite du membre visé — cette
// invitation reste en attente jusqu'à acceptation, seul moment où le UserBureau existe.
model BureauInvitation {
  id             String     @id @default(uuid())
  bureauId       String     @map("bureau_id")
  userId         String     @map("user_id")
  roleDansBureau RoleBureau @default(COLLABORATEUR) @map("role_dans_bureau")
  roleInterne    String?    @map("role_interne")
  createdAt      DateTime   @default(now()) @map("created_at")

  bureau Bureau @relation(fields: [bureauId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bureauId, userId])
  @@map("bureau_invitations")
}

model Projet {
  id             String       @id @default(uuid())
  // Un projet est soit rattaché à un bureau, soit à l'espace personnel d'un
  // utilisateur (Organizer personnel) — jamais les deux (cf. contrainte SQL).
  bureauId       String?      @map("bureau_id")
  proprietaireId String?      @map("proprietaire_id")
  nom            String
  description    String?
  dateDebut      DateTime?    @map("date_debut")
  dateFin        DateTime?    @map("date_fin")
  statut         StatutProjet @default(EN_COURS)

  // Organizer : espace de discussion en vrac, découpé en Subjects (une
  // Conversation nommée par Subject), dont le contenu est transformé en
  // tâches automatiquement (cf. phase C), indépendamment par Subject.
  estOrganizer Boolean @default(false) @map("est_organizer")

  createdAt DateTime @default(now()) @map("created_at")

  bureau        Bureau?        @relation(fields: [bureauId], references: [id], onDelete: Cascade)
  proprietaire  User?          @relation(fields: [proprietaireId], references: [id], onDelete: Cascade)
  taches        Tache[]
  conversations Conversation[]

  @@index([bureauId])
  @@index([proprietaireId])
  @@map("projets")
}

model Tache {
  id              String      @id @default(uuid())
  projetId        String      @map("projet_id")
  // Subject (Conversation) d'où provient une tâche générée par l'IA ; nul pour
  // les tâches créées manuellement.
  conversationId  String?     @map("conversation_id")
  titre           String
  description     String?
  assigneAId      String?     @map("assigne_a")
  assigneParId    String?     @map("assigne_par_id")
  statut          StatutTache @default(A_FAIRE)
  dateDebut       DateTime?   @map("date_debut")
  dateDeclaration DateTime?   @map("date_declaration")
  // Note optionnelle laissée par l'assigné en déclarant la tâche faite (cf. "Done").
  commentaireDeclaration String? @map("commentaire_declaration")
  dateValidation  DateTime?   @map("date_validation")
  valideParId     String?     @map("valide_par")
  // Date cible du rituel quotidien (cf. 2.6) — définie par le manager, jamais par l'IA.
  dateCible       DateTime?   @map("date_cible") @db.Date

  // Santé (distincte du statut), priorité, échéance réelle et estimation de charge.
  sante               SanteTache    @default(NORMAL)
  priorite            PrioriteTache @default(NORMALE)
  dateEcheance        DateTime?     @map("date_echeance")
  dureeEstimeeMinutes Int?          @map("duree_estimee_minutes")

  createdAt DateTime @default(now()) @map("created_at")

  projet            Projet             @relation(fields: [projetId], references: [id], onDelete: Cascade)
  conversation      Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assigneA          User?              @relation("TachesAssignees", fields: [assigneAId], references: [id], onDelete: SetNull)
  assignePar        User?              @relation("TachesAttribuees", fields: [assigneParId], references: [id], onDelete: SetNull)
  valideur          User?              @relation("TachesValidees", fields: [valideParId], references: [id], onDelete: SetNull)
  sousTaches        SousTache[]
  declarationTaches DeclarationTache[]
  blocages          TacheBlocage[]     @relation("TacheBlocages")
  bloqueTaches      TacheBlocage[]     @relation("TacheBloquantes")
  sessions          TacheSession[]

  @@index([projetId])
  @@index([assigneAId])
  @@index([conversationId])
  @@map("taches")
}

/**
 * Blocage actif ou résolu sur une tâche. dateFin nulle = toujours bloquant.
 */
model TacheBlocage {
  id              String      @id @default(uuid())
  tacheId         String      @map("tache_id")
  type            TypeBlocage
  cause           String?
  bloquantTacheId String?     @map("bloquant_tache_id")
  responsableId   String?     @map("responsable_id")
  dateDebut       DateTime    @default(now()) @map("date_debut")
  dateFin         DateTime?   @map("date_fin")

  createdAt DateTime @default(now()) @map("created_at")

  tache         Tache  @relation("TacheBlocages", fields: [tacheId], references: [id], onDelete: Cascade)
  bloquantTache Tache? @relation("TacheBloquantes", fields: [bloquantTacheId], references: [id], onDelete: SetNull)
  responsable   User?  @relation(fields: [responsableId], references: [id], onDelete: SetNull)

  @@index([tacheId])
  @@index([bloquantTacheId])
  @@map("taches_blocages")
}

/**
 * Session de chronomètre (start/stop) sur une tâche ; fin nulle = en cours.
 */
model TacheSession {
  id      String    @id @default(uuid())
  tacheId String    @map("tache_id")
  userId  String    @map("user_id")
  debut   DateTime  @default(now())
  fin     DateTime?

  tache Tache @relation(fields: [tacheId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tacheId])
  @@index([userId])
  @@map("taches_sessions")
}

model SousTache {
  id       String  @id @default(uuid())
  tacheId  String  @map("tache_id")
  titre    String
  estCoche Boolean @default(false) @map("est_coche")

  tache Tache @relation(fields: [tacheId], references: [id], onDelete: Cascade)

  @@index([tacheId])
  @@map("sous_taches")
}

model DeclarationJournaliere {
  id               String                      @id @default(uuid())
  userId           String                      @map("user_id")
  date             DateTime                    @db.Date
  heureDeclaration DateTime?                   @map("heure_declaration")
  statutValidation StatutValidationDeclaration @default(EN_ATTENTE) @map("statut_validation")

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  taches DeclarationTache[]

  @@unique([userId, date])
  @@index([userId])
  @@map("declarations_journalieres")
}

model DeclarationTache {
  declarationId  String  @map("declaration_id")
  tacheId        String  @map("tache_id")
  // Une tâche du jour ne compte comme faite que si le membre ET le manager l'ont cochée.
  cocheParMembre Boolean @default(false) @map("coche_par_membre")
  cocheParAdmin  Boolean @default(false) @map("coche_par_admin")

  declaration DeclarationJournaliere @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  tache       Tache                  @relation(fields: [tacheId], references: [id], onDelete: Cascade)

  @@id([declarationId, tacheId])
  @@map("declarations_taches")
}

model ScoreFiabilite {
  id                    String @id @default(uuid())
  userId                String @map("user_id")
  periode               String // ex. "2026-W06"
  tauxPonctualite       Float  @default(0) @map("taux_ponctualite")
  tauxValidationDirecte Float  @default(0) @map("taux_validation_directe")
  regularite            Float  @default(0)
  scoreGlobal           Float  @default(0) @map("score_global")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periode])
  @@map("scores_fiabilite")
}

enum NotificationType {
  TACHE_ASSIGNEE
  TACHE_ACCEPTEE
  RAPPEL_DECLARATION
  RELANCE_RETARD
  VALIDATION_A_FAIRE
  TACHE_VALIDEE
  TACHE_A_REVOIR
  RESUME_QUOTIDIEN
  RAPPORT_HEBDOMADAIRE
  INVITATION_BUREAU
  MENTION
  NOUVEAU_MESSAGE
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  message   String
  lien      String?
  lue       Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

/** Un abonnement push par appareil/navigateur ayant accepté les notifications. */
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Invitation {
  id             String     @id @default(uuid())
  email          String
  nom            String
  poste          String?
  organisationId String     @map("organisation_id")
  roleGlobal     RoleGlobal @default(MEMBRE) @map("role_global")
  tokenHash      String     @map("token_hash")
  expiresAt      DateTime   @map("expires_at")
  acceptedAt     DateTime?  @map("accepted_at")
  createdAt      DateTime   @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("invitations")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  accountId String    @map("account_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
