generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleGlobal {
  ADMIN
  MEMBRE
}

enum RoleBureau {
  MANAGER
  COLLABORATEUR
}

enum StatutProjet {
  EN_COURS
  TERMINE
  ARCHIVE
}

enum StatutTache {
  A_FAIRE
  ACCEPTEE
  EN_COURS
  DECLARE
  VALIDE
  A_REVOIR
}

enum StatutValidationDeclaration {
  EN_ATTENTE
  VALIDEE
  LITIGE
}

model Organisation {
  id              String   @id @default(uuid())
  nom             String
  logoUrl         String?  @map("logo_url")
  proprietaireId  String   @map("proprietaire_id")
  planAbonnement  String?  @map("plan_abonnement")
  dateCreation    DateTime @default(now()) @map("date_creation")

  bureaux Bureau[]
  users   User[]

  @@map("organisations")
}

enum CouleurBureau {
  BLUE
  PURPLE
  GREEN
  AMBER
  PINK
  SLATE
}

model Bureau {
  id             String   @id @default(uuid())
  organisationId String   @map("organisation_id")
  nom            String
  fuseauHoraire  String   @default("UTC") @map("fuseau_horaire")

  // Rituel de déclaration quotidienne (paramétrable par le manager, cf. 2.6)
  heureDeclaration      String @default("18:30") @map("heure_declaration")
  delaiRelanceMinutes   Int    @default(60) @map("delai_relance_minutes")
  classementFiabiliteVisible Boolean @default(true) @map("classement_fiabilite_visible")

  couleur  CouleurBureau @default(BLUE)
  photoUrl String?       @map("photo_url")
  ordre    Int           @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  membres      UserBureau[]
  projets      Projet[]
  conversation Conversation?

  @@index([organisationId])
  @@map("bureaux")
}

model Conversation {
  id        String   @id @default(uuid())
  bureauId  String?  @unique @map("bureau_id")
  projetId  String?  @unique @map("projet_id")
  createdAt DateTime @default(now()) @map("created_at")

  bureau   Bureau?   @relation(fields: [bureauId], references: [id], onDelete: Cascade)
  projet   Projet?   @relation(fields: [projetId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  auteurId       String   @map("auteur_id")
  contenu        String?
  createdAt      DateTime @default(now()) @map("created_at")

  // Pièce jointe optionnelle (cf. phase D — pas de vidéos, images limitées en poids)
  fichierUrl         String? @map("fichier_url")
  fichierNom         String? @map("fichier_nom")
  fichierType        String? @map("fichier_type")
  fichierTailleOctets Int?   @map("fichier_taille_octets")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  auteur       User         @relation(fields: [auteurId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model User {
  id             String     @id @default(uuid())
  organisationId String     @map("organisation_id")
  nom            String
  email          String     @unique
  passwordHash   String     @map("password_hash")
  roleGlobal     RoleGlobal @default(MEMBRE) @map("role_global")
  emailVerifie   Boolean    @default(false) @map("email_verifie")
  poste          String?
  bio            String?
  photoUrl       String?    @map("photo_url")

  createdAt DateTime @default(now()) @map("created_at")

  organisation           Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  bureaux                UserBureau[]
  tachesAssignees        Tache[]               @relation("TachesAssignees")
  tachesAttribuees       Tache[]               @relation("TachesAttribuees")
  tachesValidees         Tache[]               @relation("TachesValidees")
  declarationsJournalieres DeclarationJournaliere[]
  scoresFiabilite        ScoreFiabilite[]
  refreshTokens          RefreshToken[]
  notifications          Notification[]
  emailVerificationTokens EmailVerificationToken[]
  messages               Message[]
  projetsPersonnels      Projet[]

  @@index([organisationId])
  @@map("users")
}

model UserBureau {
  userId        String     @map("user_id")
  bureauId      String     @map("bureau_id")
  roleDansBureau RoleBureau @default(COLLABORATEUR) @map("role_dans_bureau")
  roleInterne   String?    @map("role_interne") // ex. "Développeur", "Designer" — utilisé par l'IA

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bureau Bureau @relation(fields: [bureauId], references: [id], onDelete: Cascade)

  @@id([userId, bureauId])
  @@map("users_bureaux")
}

model Projet {
  id          String       @id @default(uuid())
  // Un projet est soit rattaché à un bureau, soit à l'espace personnel d'un
  // utilisateur (Organizer personnel) — jamais les deux (cf. contrainte SQL).
  bureauId       String?      @map("bureau_id")
  proprietaireId String?      @map("proprietaire_id")
  nom            String
  description    String?
  dateDebut      DateTime?    @map("date_debut")
  dateFin        DateTime?    @map("date_fin")
  statut         StatutProjet @default(EN_COURS)

  // Organizer : espace de discussion en vrac, dont le contenu est transformé
  // en tâches automatiquement toutes les 30 minutes (cf. phase C).
  estOrganizer             Boolean   @default(false) @map("est_organizer")
  derniereGenerationTaches DateTime? @map("derniere_generation_taches")

  createdAt DateTime @default(now()) @map("created_at")

  bureau       Bureau?        @relation(fields: [bureauId], references: [id], onDelete: Cascade)
  proprietaire User?          @relation(fields: [proprietaireId], references: [id], onDelete: Cascade)
  taches       Tache[]
  conversation Conversation?

  @@index([bureauId])
  @@index([proprietaireId])
  @@map("projets")
}

model Tache {
  id              String      @id @default(uuid())
  projetId        String      @map("projet_id")
  titre           String
  description     String?
  assigneAId      String?     @map("assigne_a")
  assigneParId    String?     @map("assigne_par_id")
  statut          StatutTache @default(A_FAIRE)
  dateDebut       DateTime?   @map("date_debut")
  dateDeclaration DateTime?   @map("date_declaration")
  dateValidation  DateTime?   @map("date_validation")
  valideParId     String?     @map("valide_par")
  // Date cible du rituel quotidien (cf. 2.6) — définie par le manager, jamais par l'IA.
  dateCible       DateTime?   @db.Date @map("date_cible")

  createdAt DateTime @default(now()) @map("created_at")

  projet      Projet       @relation(fields: [projetId], references: [id], onDelete: Cascade)
  assigneA    User?        @relation("TachesAssignees", fields: [assigneAId], references: [id])
  assignePar  User?        @relation("TachesAttribuees", fields: [assigneParId], references: [id])
  valideur    User?        @relation("TachesValidees", fields: [valideParId], references: [id])
  sousTaches  SousTache[]
  declarationTaches DeclarationTache[]

  @@index([projetId])
  @@index([assigneAId])
  @@map("taches")
}

model SousTache {
  id       String  @id @default(uuid())
  tacheId  String  @map("tache_id")
  titre    String
  estCoche Boolean @default(false) @map("est_coche")

  tache Tache @relation(fields: [tacheId], references: [id], onDelete: Cascade)

  @@index([tacheId])
  @@map("sous_taches")
}

model DeclarationJournaliere {
  id                String                      @id @default(uuid())
  userId            String                      @map("user_id")
  date              DateTime                    @db.Date
  heureDeclaration  DateTime?                   @map("heure_declaration")
  statutValidation  StatutValidationDeclaration @default(EN_ATTENTE) @map("statut_validation")

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  taches DeclarationTache[]

  @@unique([userId, date])
  @@index([userId])
  @@map("declarations_journalieres")
}

model DeclarationTache {
  declarationId  String  @map("declaration_id")
  tacheId        String  @map("tache_id")
  // Une tâche du jour ne compte comme faite que si le membre ET le manager l'ont cochée.
  cocheParMembre Boolean @default(false) @map("coche_par_membre")
  cocheParAdmin  Boolean @default(false) @map("coche_par_admin")

  declaration DeclarationJournaliere @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  tache       Tache                  @relation(fields: [tacheId], references: [id], onDelete: Cascade)

  @@id([declarationId, tacheId])
  @@map("declarations_taches")
}

model ScoreFiabilite {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  periode               String   // ex. "2026-W06"
  tauxPonctualite       Float    @default(0) @map("taux_ponctualite")
  tauxValidationDirecte Float    @default(0) @map("taux_validation_directe")
  regularite            Float    @default(0)
  scoreGlobal           Float    @default(0) @map("score_global")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periode])
  @@map("scores_fiabilite")
}

enum NotificationType {
  TACHE_ASSIGNEE
  TACHE_ACCEPTEE
  RAPPEL_DECLARATION
  RELANCE_RETARD
  VALIDATION_A_FAIRE
  TACHE_VALIDEE
  TACHE_A_REVOIR
  RESUME_QUOTIDIEN
  RAPPORT_HEBDOMADAIRE
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  message   String
  lien      String?
  lue       Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
