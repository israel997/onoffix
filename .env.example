# API
PORT=3001
DATABASE_URL="postgresql://onoffix:onoffix@localhost:5434/onoffix?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
# En prod : URL complète (ex. rediss://user:pass@host:port pour un Redis managé avec TLS) — prioritaire sur REDIS_HOST/PORT
REDIS_URL=

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000
# Liste de domaines autorisés en CORS, séparés par des virgules (ex. pendant une
# transition de domaine). Si vide, repli sur FRONTEND_URL seul.
ALLOWED_ORIGINS=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@ooffix.site
EMAIL_FROM_NAME=OOffix

GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-flash-latest
ORGANIZER_DEBOUNCE_SECONDS=30

# Stockage fichiers (DigitalOcean Spaces, S3-compatible)
SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
SPACES_REGION=fra1
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
SPACES_PUBLIC_URL=

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
