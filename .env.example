# API
PORT=3001
DATABASE_URL="postgresql://onoffix:onoffix@localhost:5434/onoffix?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
# En prod : URL complète (ex. rediss://user:pass@host:port pour un Redis managé avec TLS) — prioritaire sur REDIS_HOST/PORT
REDIS_URL=

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=5h

FRONTEND_URL=http://localhost:3000
# Liste de domaines autorisés en CORS, séparés par des virgules (ex. pendant une
# transition de domaine). Si vide, repli sur FRONTEND_URL seul.
ALLOWED_ORIGINS=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@ooffix.site
EMAIL_FROM_NAME=OOffix

GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-flash-latest

# Repli automatique si Gemini échoue après ses tentatives (optionnel)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Stockage fichiers (DigitalOcean Spaces, S3-compatible)
SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
SPACES_REGION=fra1
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
SPACES_PUBLIC_URL=

# OAuth Google (Sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Emails autorisés à accéder au panneau d'administration plateforme (/admin), séparés par des virgules.
SUPER_ADMIN_EMAILS=israellawani.pro@gmail.com

# Notifications push web (générées une fois via `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@ooffix.site

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
